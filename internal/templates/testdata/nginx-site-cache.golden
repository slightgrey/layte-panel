# Managed by Layte Panel — do not edit by hand (site: example.com)
# Page cache: finished pages are kept here and served without PHP.
fastcgi_cache_path /var/cache/nginx/layte/example.com levels=1:2 keys_zone=layte_example_com_a379a6f6:2m max_size=256m inactive=30m use_temp_path=off;
# HTTP: only ACME challenges (renewals); everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /home/examplecom/example.com/public;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    ssl_certificate     /etc/letsencrypt/live/layte-example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/layte-example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:LayteSSL:10m;
    ssl_session_timeout 1d;
    server_name example.com www.example.com;

    root /home/examplecom/example.com/public;
    index index.php index.html index.htm;

    access_log /home/examplecom/example.com/logs/access.log;
    error_log  /home/examplecom/example.com/logs/error.log;

    client_max_body_size 64m;

    # Never cache: form posts, URLs with a query, admin/login/API/feeds,
    # WooCommerce cart pages, and visitors who are logged in, commented, or
    # have something in the cart.
    set $layte_skip_cache 0;
    if ($request_method = POST) {
        set $layte_skip_cache 1;
    }
    if ($query_string != "") {
        set $layte_skip_cache 1;
    }
    if ($request_uri ~* "/wp-admin/|/wp-json/|/xmlrpc\.php|wp-.*\.php|/feed/|sitemap(_index)?\.xml|/cart/|/checkout/|/my-account/") {
        set $layte_skip_cache 1;
    }
    if ($http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|woocommerce_items_in_cart|woocommerce_cart_hash|wp_woocommerce_session") {
        set $layte_skip_cache 1;
    }

    # Never serve dotfiles (.git, .env, .htaccess), except ACME challenges.
    location ~ /\.(?!well-known/) {
        deny all;
    }
    location = /wp-config.php {
        deny all;
    }
    # No PHP execution inside upload folders.
    location ~* /(?:uploads|files)/.*\.php$ {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_pass unix:/run/php/layte-example.com-php8.3.sock;
        fastcgi_read_timeout 300;

        fastcgi_cache layte_example_com_a379a6f6;
        fastcgi_cache_key "$scheme$request_method$host$request_uri";
        fastcgi_cache_valid 200 301 302 30m;
        fastcgi_cache_use_stale error timeout updating invalid_header http_500 http_503;
        fastcgi_cache_lock on;
        fastcgi_cache_bypass $layte_skip_cache;
        fastcgi_no_cache $layte_skip_cache;
        add_header X-Layte-Cache $upstream_cache_status always;
    }

    location ~* \.(?:css|js|jpe?g|png|gif|ico|svg|webp|avif|woff2?)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }
}
