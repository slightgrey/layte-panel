; Managed by Layte Panel — do not edit by hand (site: {{.Domain}})
[{{.Domain}}]
user = {{.User}}
group = {{.User}}

listen = {{.Socket}}
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

; ondemand: no idle workers, so many small sites fit in 1 GB of RAM.
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
pm.max_requests = 500

chdir = /
security.limit_extensions = .php

; Keep PHP inside the site's own directory.
php_admin_value[open_basedir] = {{.Dir}}/
php_admin_value[upload_tmp_dir] = {{.Dir}}/tmp
php_admin_value[sys_temp_dir] = {{.Dir}}/tmp
php_admin_value[session.save_path] = {{.Dir}}/tmp
php_admin_value[error_log] = {{.Dir}}/logs/php-error.log
php_admin_flag[log_errors] = on

php_value[upload_max_filesize] = 64M
php_value[post_max_size] = 64M
php_value[memory_limit] = 256M
