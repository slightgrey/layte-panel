# Layte Panel privileged agent. Runs as root and executes only the fixed list of
# allowlisted actions, received over /run/layte/agent.sock (group layte, 0660).
[Unit]
Description=Layte Panel agent (privileged helper)
Documentation=https://github.com/slightgrey/layte-panel
After=network.target

[Service]
Type=simple
User=root
# Primary group layte so /run/layte is reachable by the panel (mode 0750).
Group=layte
ExecStart=/usr/local/bin/layte agent --config /etc/layte/config.toml
Restart=on-failure
RestartSec=2s

RuntimeDirectory=layte
RuntimeDirectoryMode=0750

# The agent manages nginx, PHP-FPM, certbot, cron and ufw, so it can't use
# ProtectSystem; keep the hardening that doesn't get in the way.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0022

[Install]
WantedBy=multi-user.target
